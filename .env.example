# 火山引擎 Ark — 默认统一 Key
ARK_API_KEY=your_ark_api_key

# LLM 分镜接口
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3

# Seedance 默认复用共享 Key 及 ARK_BASE_URL；Agent Plan 不需要视频专用 Key。
# 独立视频 Key/接口仅在使用另一套凭据时配置，URL 必须与 Key 所属服务匹配。
# ARK_API_KEY_SEEDANCE=your_seedance_api_key
# ARK_BASE_URL_SEEDANCE=https://ark.cn-beijing.volces.com/api/v3

# Agent Plan 模型名；按量计费接口可使用 doubao-seedance-2-0-mini-260615
SEEDANCE_MODEL=doubao-seedance-2.0-mini

# LLM 文本模型 (分镜脚本生成)
LLM_MODEL=doubao-seed-2.0-lite

# 生成后自适应 5/9 点语义验收；默认复用 LLM_MODEL
SEMANTIC_REVIEW_MODEL=doubao-seed-2.0-lite
SEMANTIC_REVIEW_ENABLED=true
SEMANTIC_REVIEW_IMAGE_DETAIL=high

# TTS: macos 或 volcano
TTS_ENGINE=macos
TTS_VOICE=Tingting

# TTS_ENGINE=volcano 时必填；音色根据分镜自动选择
# VOLCANO_TTS_API_KEY=your_doubao_speech_api_key
